<?xml version="1.0" encoding="utf-8"?>
<!-- The application id stays com.overmindy.mimicodecdemo so updates keep the installed app's data and signature. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.overmindy.mimicodecdemo"
          android:versionCode="20" android:versionName="5.1.1">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:label="@string/app_name"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher"
                 android:theme="@android:style/Theme.Material.NoActionBar"
                 android:extractNativeLibs="true"
                 android:allowBackup="false"
                 android:usesCleartextTraffic="false">
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <activity android:name="com.overmindy.duplex.MainActivity" android:exported="true"
                  android:screenOrientation="portrait"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
